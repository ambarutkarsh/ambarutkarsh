APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-64-char-string-please-change-me-now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CONFIG_DB_HOST=postgres
CONFIG_DB_PORT=5432
CONFIG_DB_NAME=streamliner_config
CONFIG_DB_USER=streamliner
CONFIG_DB_PASSWORD=change-this-password

ENCRYPTION_KEY=change-this-to-a-random-32-char-key-!

REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_TTL=300

MAX_QUERY_ROWS=10000
MAX_EXPORT_ROWS=100000
QUERY_TIMEOUT=30

LOG_LEVEL=INFO
