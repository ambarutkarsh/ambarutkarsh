# Application
APP_ENV=production
APP_PORT=8000
APP_NAME=Data Streamliner
APP_VERSION=1.0.0

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Configuration Database (PostgreSQL)
CONFIG_DB_HOST=postgres
CONFIG_DB_PORT=5432
CONFIG_DB_NAME=streamliner_config
CONFIG_DB_USER=streamliner
CONFIG_DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Credential Encryption Key for stored data source passwords
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_CHARACTER_KEY

# Redis Cache
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_TTL=300

# Query Limits
MAX_QUERY_ROWS=10000
MAX_EXPORT_ROWS=100000
QUERY_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
