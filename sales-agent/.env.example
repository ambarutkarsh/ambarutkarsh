# Copy to .env (never commit it):  cp .env.example .env

# ---- Mailbox (Gmail / Google Workspace with an App Password) ----
# Use a mailbox on a separate sending domain, not your main one.
# App Password: myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optional: a separate mailbox per product. These override the values above.
# RETENTIONOS_SMTP_USER=
# RETENTIONOS_SMTP_PASSWORD=
# CLASS_SMTP_USER=
# CLASS_SMTP_PASSWORD=

# ---- Email verification (add one; without it Closer never sends) ----
REOON_API_KEY=          # 600 free checks a month: reoon.com
ZEROBOUNCE_API_KEY=     # 100 free checks a month: zerobounce.net

# ---- Optional ----
CLAUDE_MODEL=           # blank = your Claude Code default
